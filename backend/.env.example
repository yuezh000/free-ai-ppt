# Copy these values to /etc/freeppt-api.env on the backend server.
# Never put a real Resend API key or token in this repository.

FREEPPT_BIND=127.0.0.1:8080
DATABASE_URL=sqlite:///var/lib/freeppt/freeppt.db?mode=rwc
FRONTEND_ORIGIN=https://freeaippt.space
PUBLIC_BASE_URL=https://api.freeaippt.space

# Private Vercel Blob store. The read-write token remains server-only.
# Clients receive narrowly scoped signed URLs that expire after a few minutes.
BLOB_STORE_ID=store_replace_with_your_store_id
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_with_your_token

RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM="FreeAIPPT <noreply@mail.freeaippt.space>"

# Generate independent random values for these two secrets.
AGENT_API_TOKEN=replace_with_a_long_random_agent_token
AUTH_PEPPER=replace_with_a_long_random_auth_pepper

# Comma-separated, case-insensitive email addresses allowed to call /api/v1/admin/*.
ADMIN_EMAILS=admin@example.com

# Single mutually exclusive mode switch. true = waitlist registration; false = task submission.
WAITLIST=true

CLAIM_LEASE_SECONDS=900
MAX_UPLOAD_BYTES=104857600
